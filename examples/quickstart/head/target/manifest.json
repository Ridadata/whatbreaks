   "name": "stg_orders",
   "resource_type": "model",
   "package_name": "shop",
   "original_file_path": "models/stg_orders.sql",
   "raw_code": "\nwith source as (\n    select * from {{ ref('raw_orders') }}\n),\nrenamed as (\n    select\n        id           as order_id,\n        user_id      as customer_id,\n        order_date,\n        amount\n    from source\n)\nselect * from renamed\n",
   "depends_on": {
    "nodes": [
     "seed.shop.raw_orders"
    ]
   },
   "columns": {},
   "config": {
    "materialized": "view"
   }
  },
  "model.shop.orders": {
   "name": "orders",
   "resource_type": "model",
   "package_name": "shop",
   "original_file_path": "models/orders.sql",
   "raw_code": "\nwith orders as (\n    select * from {{ ref('stg_orders') }}\n)\nselect\n    orders.order_id,\n    orders.customer_id,\n    orders.status      as order_status,\n    orders.amount\nfrom orders\n",
   "depends_on": {
    "nodes": [
     "model.shop.stg_orders"
    ]
   },
   "columns": {
    "order_id": {
     "name": "order_id"
