     "name": "order_status"
    },
    "amount": {
     "name": "amount"
    }
   },
   "config": {
    "materialized": "view"
   }
  },
  "model.shop.customers": {
   "name": "customers",
   "resource_type": "model",
   "package_name": "shop",
   "original_file_path": "models/customers.sql",
   "raw_code": "\nwith completed as (\n    select * from {{ ref('stg_orders') }} where status = 'completed'\n)\nselect\n    customer_id,\n    count(order_id) as completed_orders,\n    sum(amount)     as lifetime_value\nfrom completed\ngroup by customer_id\n",
   "depends_on": {
    "nodes": [
     "model.shop.stg_orders"
    ]
   },
   "columns": {},
   "config": {
    "materialized": "view"
   }
  },
